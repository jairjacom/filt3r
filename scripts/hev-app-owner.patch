diff --git a/src/hev-socks5-session.c b/src/hev-socks5-session.c
index e9d8458..7a55ffb 100644
--- a/src/hev-socks5-session.c
+++ b/src/hev-socks5-session.c
@@ -7,6 +7,7 @@
  ============================================================================
  */
 
+#include <stdio.h>
 #include <string.h>
 
 #include "hev-utils.h"
@@ -23,6 +24,7 @@ hev_socks5_session_run (HevSocks5Session *self)
 {
     HevSocks5SessionIface *iface;
     HevConfigServer *srv;
+    char user[320];
     int res;
 
     LOG_D ("%p socks5 session run", self);
@@ -37,9 +39,13 @@ hev_socks5_session_run (HevSocks5Session *self)
     }
 
     if (srv->user && srv->pass) {
-        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), srv->user,
-                                    srv->pass);
-        LOG_D ("%p socks5 client auth %s:%s", self, srv->user, srv->pass);
+        /* the node is the first member of the session data (filt3r patch) */
+        HevSocks5SessionData *data =
+            (HevSocks5SessionData *)hev_socks5_session_get_node (self);
+
+        snprintf (user, sizeof (user), "%s#%s", srv->user, data->owner);
+        hev_socks5_client_set_auth (HEV_SOCKS5_CLIENT (self), user, srv->pass);
+        LOG_D ("%p socks5 client auth %s:%s", self, user, srv->pass);
     }
 
     res = hev_socks5_client_handshake (HEV_SOCKS5_CLIENT (self), srv->pipeline);
