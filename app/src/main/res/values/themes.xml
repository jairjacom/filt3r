<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light variant. The dark variant lives in values-night. Splash: system splash (API 31+), shield pops in on the canvas colour. -->
    <style name="Theme.Filt3r" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorBackground">@color/canvas_light</item>
        <item name="colorSurface">@color/canvas_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/canvas_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_shield_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>

    <!-- Applied after a generated palette (or Material You): the window follows the palette's background colour. -->
    <style name="ThemeOverlay.Filt3r.Generated" parent="">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Pure black canvas, applied last in the dark theme. -->
    <style name="ThemeOverlay.Filt3r.PureBlack" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
