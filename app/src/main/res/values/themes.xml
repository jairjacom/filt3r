<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light variant. The dark variant lives in values-night. Splash: system splash (API 31+), shield on the canvas colour, no animation. -->
    <style name="Theme.Filt3r" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorBackground">@color/canvas_light</item>
        <item name="colorSurface">@color/canvas_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/canvas_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_shield</item>
    </style>
</resources>
