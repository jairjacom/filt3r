<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light variant. The dark variant lives in values-night. Splash: system splash (API 31+), shield pops in on the canvas colour. -->
    <style name="Theme.Filt3r" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorBackground">@color/canvas_light</item>
        <item name="colorSurface">@color/canvas_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/canvas_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_shield_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>

    <!-- Container colours for the fixed filt3r palette (light). The generated palettes bring their own. -->
    <style name="ThemeOverlay.Filt3r.DefaultContainers" parent="">
        <item name="colorPrimaryContainer">#FFDAD7</item>
        <item name="colorOnPrimaryContainer">#410004</item>
        <item name="colorSecondary">#775653</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#F5DDDA</item>
        <item name="colorOnSecondaryContainer">#2C1512</item>
    </style>

    <!-- Applied after a generated palette (or Material You): the window follows the palette's background colour. -->
    <style name="ThemeOverlay.Filt3r.Generated" parent="">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Pure black canvas, applied last in the dark theme. -->
    <style name="ThemeOverlay.Filt3r.PureBlack" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Applied when the Expressive buttons effect is off: the classic Material 3 buttons instead of the Expressive ones. -->
    <style name="ThemeOverlay.Filt3r.ClassicButtons" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.Material3.Button.TonalButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Material3.Button.OutlinedButton</item>
        <item name="materialButtonElevatedStyle">@style/Widget.Material3.Button.ElevatedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Material3.Button.TextButton</item>
        <item name="buttonBarButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.Material3.MaterialButtonToggleGroup</item>
    </style>
</resources>
